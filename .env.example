# Copy this file to .env or export these variables in your shell.
# Do not commit real API keys.

# Cloud model APIs, only needed for the corresponding providers.
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional local serving variables.
PYTHON_BIN=python3
HOST=0.0.0.0
PORT=8000

# Expected dataset/output locations relative to the repository root.
DATA_ROOT=Dataset
OUTPUT_DIR=Outputs

